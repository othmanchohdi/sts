{% stylesheet %}
  .ssland-final-cta {
    position: relative;
    overflow: clip;
    border-top: 1px solid var(--ssl-hairline);
  }
  .ssland-final-cta-inner {
    position: relative;
    max-width: 860px;
    margin: 0 auto;
    padding: clamp(56px, 8vw, 108px) 22px;
    text-align: center;
  }
  .ssland-final-cta-heading {
    font-family: var(--ssl-font-display);
    font-size: clamp(34px, 5vw, 64px);
    line-height: 1.0;
    font-weight: 300;
    letter-spacing: normal;
    margin: 0 0 18px;
    text-wrap: balance;
  }
  .ssland-final-cta-subcopy {
    font-size: 16px;
    line-height: 1.6;
    font-weight: 400;
    color: var(--ssl-ink-muted);
    margin: 0 auto 34px;
    max-width: 48ch;
  }
  .ssland-final-cta-minis {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 14px;
    max-width: 560px;
    margin: 0 auto 20px;
  }
  .ssland-final-cta-mini-label {
    font-family: var(--ssl-font-mono);
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 10px;
  }
  .ssland-mini-plan-card[data-ssland-plan-option='sub'] .ssland-final-cta-mini-label {
    color: var(--ssl-violet);
  }
  .ssland-mini-plan-card[data-ssland-plan-option='once'] .ssland-final-cta-mini-label {
    color: var(--ssl-ink-muted);
  }
  .ssland-final-cta-mini-price {
    font-family: var(--ssl-font-display);
    font-size: 25px;
    font-weight: 300;
    letter-spacing: normal;
    color: var(--ssl-solar-text);
  }
  .ssland-final-cta-mini-sub {
    font-family: var(--ssl-font-mono);
    font-size: 13px;
    letter-spacing: 0.04em;
    font-weight: 400;
    color: var(--ssl-ink-muted);
  }
  .ssland-final-cta-button {
    width: 100%;
    max-width: 560px;
  }
{% endstylesheet %}

<section class="ssland-final-cta section-{{ section.id }}">
  <div class="ssland-final-cta-inner">
    <h2 class="ssland-final-cta-heading">{{ section.settings.heading }}</h2>
    {%- if section.settings.subcopy != blank -%}
      <p class="ssland-final-cta-subcopy">{{ section.settings.subcopy }}</p>
    {%- endif -%}

    <div class="ssland-final-cta-minis">
      <div class="ssland-mini-plan-card" data-ssland-plan-option="sub" data-ssland-plan-trigger="sub" role="button" tabindex="0">
        <div class="ssland-final-cta-mini-label">{{ section.settings.sub_label }}</div>
        <div class="ssland-final-cta-mini-price">{{ section.settings.sub_price }}</div>
        <div class="ssland-final-cta-mini-sub">{{ section.settings.sub_subtext }}</div>
      </div>
      <div class="ssland-mini-plan-card" data-ssland-plan-option="once" data-ssland-plan-trigger="once" role="button" tabindex="0">
        <div class="ssland-final-cta-mini-label">{{ section.settings.once_label }}</div>
        <div class="ssland-final-cta-mini-price">{{ section.settings.once_price }}</div>
        <div class="ssland-final-cta-mini-sub">{{ section.settings.once_subtext }}</div>
      </div>
    </div>

    <button type="button" class="ssland-btn-gold ssland-final-cta-button" data-ssland-plan-trigger="sub">
      <span data-ssland-show="sub">{{ section.settings.cta_label_sub }}</span>
      <span data-ssland-show="once">{{ section.settings.cta_label_once }}</span>
    </button>
  </div>
</section>

{% schema %}
  {
    "name": "SS Landing: Final CTA",
    "class": "section-ssland-final-cta",
    "settings": [
      {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "Your cells are calling. Answer with Star Sweat."
      },
      {
        "type": "richtext",
        "id": "subcopy",
        "label": "Subcopy",
        "default": "<p>Every run is tested before it ships. When one sells through, the next is about three weeks out. No countdown — just how long it takes to make more.</p>"
      },
      {
        "type": "header",
        "content": "Subscribe mini card"
      },
      {
        "type": "text",
        "id": "sub_label",
        "label": "Label",
        "default": "Subscribe & save"
      },
      {
        "type": "text",
        "id": "sub_price",
        "label": "Price",
        "default": "$95.76"
      },
      {
        "type": "text",
        "id": "sub_subtext",
        "label": "Subtext",
        "default": "$3.19 / can · free shipping"
      },
      {
        "type": "header",
        "content": "Buy once mini card"
      },
      {
        "type": "text",
        "id": "once_label",
        "label": "Label",
        "default": "Buy once"
      },
      {
        "type": "text",
        "id": "once_price",
        "label": "Price",
        "default": "$119.70"
      },
      {
        "type": "text",
        "id": "once_subtext",
        "label": "Subtext",
        "default": "$3.99 / can · $10 shipping"
      },
      {
        "type": "header",
        "content": "CTA"
      },
      {
        "type": "text",
        "id": "cta_label_sub",
        "label": "CTA label (subscribe selected)",
        "default": "Get Star Sweat — $95.76 / month"
      },
      {
        "type": "text",
        "id": "cta_label_once",
        "label": "CTA label (buy once selected)",
        "default": "Get one 30-pack — $119.70"
      }
    ],
    "presets": [
      {
        "name": "SS Landing: Final CTA"
      }
    ],
    "enabled_on": {
      "templates": ["page"]
    }
  }
{% endschema %}
