                "id": "text",
                "label": "Text"
            },
            {
                "type": "text",
                "id": "name",
                "label": "Name"
            },
            {
                "type": "text",
                "id": "date",
                "label": "Date"
            }
            
          ]
        }
      ],
  "presets": [
    {
      "name": "What customers saying",
    }
  ],
  "enabled_on": {
