<script>
    class ReviewSlider extends HTMLElement {
        constructor() {
            super();

        }
        connectedCallback() {

            const swiperReviews = new Swiper(this.querySelector('.swiper-container'), {
                slidesPerView: 3,
                spaceBetween: 32,
                loop: true,
                autoplay: true,
                speed:1000,
                delay: 3000,
                breakpoints: {
                    0: {
                     slidesPerView: 1,
                    },
                    550: {
                        slidesPerView: 2,
                        spaceBetween: 15,
                    },
                    1024: { 
                        slidesPerView: 3,
                    }
                },
                 pagination: {
                    el: this.querySelector('.swiper-pagination'),
                    clickable: true,
                }
            });

        }
    }


    document.addEventListener("DOMContentLoaded", function() {
        
        if (!customElements.get('review-slider')) {
        customElements.define('review-slider', ReviewSlider);
        }
    }) 

    document.addEventListener('shopify:section:load', () => {
        if (!customElements.get('review-slider')) {
        customElements.define('review-slider', ReviewSlider);
        }
    })



</script>
    

{% schema %}
{
  "name": "What customers saying",
  "class": "section-customerssaying",
  "settings": [
