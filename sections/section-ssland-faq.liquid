{% stylesheet %}
  .ssland-faq-section {
    border-top: 1px solid var(--ssl-hairline);
    background: var(--ssl-base);
  }
  .ssland-faq-inner {
    max-width: 920px;
  }
  .ssland-faq-heading {
    font-family: var(--ssl-font-display);
    font-size: clamp(28px, 3.6vw, 44px);
    line-height: 1.05;
    font-weight: 300;
    letter-spacing: normal;
    margin: 0 0 30px;
  }
{% endstylesheet %}

{%- liquid
  assign ssl_has_color_override = false
  if section.settings.color_background != blank or section.settings.color_heading != blank or section.settings.color_text != blank or section.settings.color_text_muted != blank or section.settings.color_button_text != blank
    assign ssl_has_color_override = true
  endif
-%}
{%- if ssl_has_color_override -%}
  <style>
    .section-{{ section.id }} {
      {%- if section.settings.color_background != blank %}
      background-color: {{ section.settings.color_background }};
      {%- endif %}
      {%- if section.settings.color_text != blank %}
      color: {{ section.settings.color_text }};
      --ssl-ink: {{ section.settings.color_text }};
      {%- endif %}
      {%- if section.settings.color_text_muted != blank %}
      --ssl-ink-muted: {{ section.settings.color_text_muted }};
      {%- endif %}
    }
    {%- if section.settings.color_heading != blank %}
    .section-{{ section.id }} [class*="-headline"],
    .section-{{ section.id }} [class*="-heading"] {
      color: {{ section.settings.color_heading }};
    }
    {%- endif %}
    {%- if section.settings.color_button_text != blank %}
    .section-{{ section.id }} [class*="-btn-gold"],
    .section-{{ section.id }} [class*="-cta"] {
      color: {{ section.settings.color_button_text }};
    }
    {%- endif %}
  </style>
{%- endif -%}
<section class="ssland-faq-section section-{{ section.id }}">
  <div class="ssland-section-inner ssland-faq-inner">

    <h2 class="ssland-faq-heading">{{ section.settings.heading }}</h2>

    {%- for block in section.blocks -%}
      <details class="ssland-faq-item" {{ block.shopify_attributes }}>
        <summary class="ssland-faq-summary">
          {{ block.settings.question }}
          <span class="ssland-faq-icon" aria-hidden="true">+</span>
        </summary>
        <p class="ssland-faq-body">{{ block.settings.answer }}</p>
      </details>
    {%- endfor -%}

  </div>
</section>

{% schema %}
  {
    "name": "SS Landing: FAQ",
    "class": "section-ssland-faq",
    "settings": [
      {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "Questions, answered"
      },
      { "type": "header", "content": "Colors" },
      { "type": "paragraph", "content": "Leave blank to use the theme's default Star Sweat colors." },
      { "type": "color", "id": "color_background", "label": "Background color" },
      { "type": "color", "id": "color_heading", "label": "Heading color" },
      { "type": "color", "id": "color_text", "label": "Text color" },
      { "type": "color", "id": "color_text_muted", "label": "Muted / secondary text color" },
      { "type": "color", "id": "color_button_text", "label": "Button text color" }
    ],
    "blocks": [
      {
        "type": "faq",
        "name": "FAQ item",
        "settings": [
          {
            "type": "text",
            "id": "question",
            "label": "Question",
            "default": "What is Elemental Water?"
          },
          {
            "type": "richtext",
            "id": "answer",
            "label": "Answer",
            "default": "<p>A functional beverage: purified water as the base, with molecular hydrogen at 2.2 ppm minimum, magnesium, and trace colloidal gold and platinum.</p>"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "SS Landing: FAQ",
        "blocks": [
          { "type": "faq", "settings": { "question": "What is Elemental Water?", "answer": "<p>A functional beverage: purified water as the base, with molecular hydrogen at 2.2 ppm minimum, magnesium, and trace colloidal gold and platinum. Five things, in a sealed 12 oz can.</p>" } },
          { "type": "faq", "settings": { "question": "How is it different from other hydrogen water?", "answer": "<p>Most hydrogen water is a tablet you drop in a glass, a machine on a counter, or a pouch that's lost its hydrogen by the time you open it. Ours is sealed in aluminum, tested per run, and publishes the concentration. It also adds magnesium and trace gold and platinum, which plain hydrogen water doesn't.</p>" } },
          { "type": "faq", "settings": { "question": "How much hydrogen is in each can?", "answer": "<p>A minimum of 2.2 ppm dissolved H₂, independently tested. If a run tests under that, it doesn't ship.</p>" } },
          { "type": "faq", "settings": { "question": "Does it taste different?", "answer": "<p>Barely. Hydrogen has no taste. Cold, it drinks like clean water with a light crispness from the dissolved gas. Magnesium is the only thing you might notice, faintly.</p>" } },
          { "type": "faq", "settings": { "question": "How should I drink and store it?", "answer": "<p>One can a day, cold. Store sealed cans cool and out of direct sun. Once open, finish within about 30 minutes — hydrogen leaves an open can the way carbonation does.</p>" } },
          { "type": "faq", "settings": { "question": "How does the subscription work?", "answer": "<p>One 30-pack ships monthly at $95.76 with free shipping, renewing every 30 days. Skip, pause or change frequency from your account. We email before each charge.</p>" } },
          { "type": "faq", "settings": { "question": "Can I cancel anytime?", "answer": "<p>Yes — two clicks in your account, including before your second box. No email, no phone call. Cans already shipped can't be returned.</p>" } },
          { "type": "faq", "settings": { "question": "What does shipping cost, and where is it made?", "answer": "<p>Subscriptions ship free, every order. One-time orders are $10. Made in the United States with a copacker chosen for hydrogen retention.</p>" } }
        ]
      }
    ],
    "enabled_on": {
      "templates": ["page"]
    }
  }
{% endschema %}
