                        scale: 0.7,
                        opacity: 0
                    },
                    {
                        y:0,
                        right:0,
                        scale: 1,
                        opacity: 1,
                        duration: 1,
                        ease: "power3.inOut"
                    },
                    0
                );
                superStarTL.fromTo('.super-star-elixir-right .super-star-elixir-box:nth-child(2)',
                    {
                        y: 0,
                        right:-300,
                        scale: 0.7,
                        opacity: 0
                    },
                    {
                        y:0,
                        right:0,
                        scale: 1,
                        opacity: 1,
                        duration: 1,
                        ease: "power3.inOut"
                    },
                    0.1
                );
                superStarTL.fromTo('.super-star-elixir-right .super-star-elixir-box:nth-child(3)',
                    {
                        y: 0,
                        right:-300,
                        scale: 0.7,
                        opacity: 0
                    },
                    {
                        y:0,
