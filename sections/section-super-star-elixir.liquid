                        scale: 1,
                        opacity: 1,
                        duration: 1,
                        ease: "power3.inOut"
                    },
                    0.2
                );

                superStarTL.fromTo('.super-star-elixir-right .super-star-elixir-box:first-child .super-star-pointer',
                    {
                        y: 0,
                        scale:0.5,
                        opacity: 0
                    },
                    {
                        y:0,
                        scale: 1,
                        opacity: 1,
