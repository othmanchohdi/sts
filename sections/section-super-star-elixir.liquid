                        opacity: 1,
                        duration: 1,
                        ease: "power3.inOut"
                    },
                    0.5
                );
             
            },
            "(max-width: 767px)": function() {

               
               //Images
                superStarMobileTL.fromTo('.elixir-main-img',
                    {
                        y: 30,
                        left:10,
                        scale: 0.7,
                    },
                    {
                        y:0,
                        left:100,
                        scale: 1,
                        duration: 1,
                        ease: "power3.inOut",
                         onComplete: () => {
                          const elementelixirMainImg = document.querySelector('.elixir-main-img');
                          if (elementelixirMainImg) elementelixirMainImg.classList.add('elixirmainimSlideUpDown');
                        }
                    },
                    0
                );
                 superStarMobileTL.fromTo('.elixir-rock-img',
                    {
                        y: 200,
                        left:270,
                        scale: 0.7,
                        rotation: -50
                    },
                    {
                        y:100,
                        left:210,
                        scale: 1,
                        rotation: -29,
                        duration: 1,
                        ease: "power3.inOut"
                    },
                    0.1
                );
                superStarMobileTL.fromTo('.super-star-elixir-lighting-blue',
                    {
                        scale: 0.3,
                    },
                    {
                        scale: 1,
                        duration: 1,
                        ease: "power3.inOut"
                    },
                    0.15
                );
                superStarMobileTL.fromTo('.super-star-elixir-lighting-violet',
                    {
                        scale: 0.3,
                    },
                    {
                        scale: 1,
                        duration: 1,
                        ease: "power3.inOut"
                    },
                    0.2
                );
            }
        })
      
    })
</script>


