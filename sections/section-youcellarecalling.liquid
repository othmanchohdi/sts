{% stylesheet %}
    /* About us block */
    .aboutus-grid{
        display:grid;
        grid-template-columns:1fr 400px;
        gap:0;
        padding-bottom:150px;
    }
    .aboutus-text p{
        color:var(--grey-20);
        font-weight: 400;
        line-height:1.6;
    }
    .aboutus-title{
        margin-bottom:7px;
    }
    .aboutus-btn{
        margin-top:30px;
    }
    .yourcellsarecalling-wrp .stars-shower{
        top:0;
    }
     /* General section settings */
     .yourcellsarecalling-container{
        max-width:870px;
        margin:auto;
     }
    .yourcellsarecalling-wrp{ 
        position:relative;
        padding-top: 100px;
        overflow:hidden;
    }
    .yourcellsarecalling-btn{
         position:relative;
        text-align:center;
        margin-top:30px;
    }
    .yourcellsarecalling-title{
        position:relative;
        line-height:1.3;
        margin:0 auto 15px auto;
    }
    .yourcellsarecalling-text{
        position:relative;
        margin:auto;
    }
    .yourcellsarecalling-text p{
        line-height:1.3;
    }
    .section-{{ section.id }} .img-starman{
        display:block;
        margin:30px auto 0 auto;
    }
    .section-{{ section.id }} .mobile-img-starman{
         display:none;
    }

    .yourcellsarecalling-bg-images{
        position:absolute;
        width:100%;
        height:100%;
        display:flex;
        align-items:center;
        justify-content:center;
    }
    .img-starscrumbs{
        position:absolute;
    }
    .img-violetbubble{
         position:absolute;
    }
    .mobile-img-violetbubble{
        position:absolute;
        display:none;
    }
    
    @media(max-width:768px){
        .yourcellsarecalling-wrp{
            padding-top:0;
        }
        .aboutus-grid{
            grid-template-columns:1fr;
           padding-bottom: 114px;
        }
        .aboutus-grid .aboutus-text{
            order:2;
        }
        .aboutus-grid .aboutus-img{
            order:1;
        }
         .aboutus-title{
            line-height:1.3;
            margin-bottom:10px;
        }
        .aboutus-btn {
            margin-top: 20px;
        }
        .yourcellsarecalling-title{
            font-size:26px;
        }
        .yourcellsarecalling-text p{
            font-size:15px;
        }
        .yourcellsarecalling-btn{
            margin-top:15px;
        }
        .img-violetbubble{
            display:none;
        }
        .mobile-img-violetbubble{
            display:block;
        }
         .section-{{ section.id }} .img-starman{
            display:none;
        }
        .section-{{ section.id }} .mobile-img-starman{
            display:block;
            margin:30px auto 0 auto;
        }
    }
{% endstylesheet %}
{% style %}
    .imageblock-img{
        max-width:var(--width);
    }
     @media(max-width:768px){
        .imageblock-img{
            max-width:var(--width-mob);
        }
     }
{% endstyle %}
<section class="yourcellsarecalling-wrp section-{{ section.id }}">

   
    {% render 'stars-shower', count: 20 %}

    <div class="yourcellsarecalling-bg-images">
        {% if section.settings.background_image_2 != blank %}
            {{
                section.settings.background_image_2
                | image_url: width: 1946
                | image_tag:
                loading: loading,
                sizes: '100vw',
                widths: '246, 493, 600, 713, 823, 990, 1100, 1206, 1346, 1426, 1646, 1946',
                alt: section.settings.background_image_2.alt,
                class: "img-starscrumbs"
            }}
        {% endif %}
        {% if section.settings.background_image != blank %}
            {{
                section.settings.background_image
                | image_url: width: 1946
                | image_tag:
                loading: loading,
                sizes: '100vw',
                widths: '246, 493, 600, 713, 823, 990, 1100, 1206, 1346, 1426, 1646, 1946',
                alt: section.settings.background_image.alt,
                class: "img-violetbubble"
            }}
        {% endif %}
        {% if section.settings.mobile_background_image != blank %}
            {{
                section.settings.mobile_background_image
                | image_url: width: 1946
                | image_tag:
                loading: loading,
                sizes: '100vw',
                widths: '246, 493, 600, 713, 823, 990, 1100, 1206, 1346, 1426, 1646, 1946',
                alt: section.settings.mobile_background_image.alt,
                class: "mobile-img-violetbubble"
            }}
        {% endif %}
    </div>

    {% for block in section.blocks %}
       
        <div class="container container-1165">
            {% if block.type == 'block' %}
                <div class="aboutus-grid">

                    <div class="aboutus-text">

                        {% if block.settings.label != blank %}

                            <div class="caps small color-violet weight_700 aboutus-label overflow-hidden">{{block.settings.label}}</div>
                        
                        {% endif %}

                        {% if block.settings.title != blank %}

                            <div class="h2 aboutus-title overflow-hidden">{{block.settings.title}}</div>
                        
                        {% endif %}
                    
                        {% if block.settings.text != blank %}
                            <div class="aboutus-text"> 
                                {{block.settings.text}}
                            </div>
                        {% endif %}
                            {% if block.settings.button_label != blank %}
                            <div class="aboutus-btn ">
                                <a href="{{block.settings.url | default: '#'}}" 
                                class="overflow-hidden weight-700 h6 c-btn c-btn-icon c-btn--dark">
                                    {{ block.settings.button_label }}
                                    {% render 'icon' with 'starship-violet' %}
                                </a>
                            </div>
                        {% endif %}
                    </div>
                    <div class="aboutus-img">

                        {% if block.settings.image != blank %}
                            {{
                                block.settings.image
                                | image_url: width: 1946
                                | image_tag:
                                loading: loading,
                                sizes: '100vw',
                                widths: '246, 493, 600, 713, 823, 990, 1100, 1206, 1346, 1426, 1646, 1946',
                                alt: block.settings.image.alt,
                                class: "aboutus-planet-img",
                                style:"opacity:.5;"
                            }}
                        {% endif %}
                    </div> 
                </div>
            {% endif %}
            {% if block.type == 'image_block' %}
                <div class="imageblock-wrp">

                        {% if block.settings.image != blank %}
                            <img src="{{ block.settings.image | img_url : 'x500' }}" 
                            class="imageblock-img"
                            style="--width:{{block.settings.image_width}}px;--width-mob:{{block.settings.image_width_mob}}px;"
                            alt="{{block.settings.image.alt}}">
                         
                        {% endif %}
                    </div> 
            {% endif %}   
        </div>
        
    {% endfor %}
    
    <div class="container ">
        <div class="yourcellsarecalling-container">
            {% if section.settings.title != blank %}

                <div class="h2 yourcellsarecalling-title center overflow-hidden">{{section.settings.title}}</div>
              
            {% endif %}
        
            {% if section.settings.text != blank %}
                <div class="yourcellsarecalling-text center h5 weight_400"> 
                    {{section.settings.text}}
                </div>
            {% endif %}
                {% if section.settings.button_label != blank %}
                <div class="yourcellsarecalling-btn">
                    <a href="{{section.settings.url | default: '#'}}" class="overflow-hidden weight-700 h6 c-btn c-btn-icon c-btn--hollow">
                        {{ section.settings.button_label }}
                        {% render 'icon' with 'starship-violet' %}
                     
                    </a>
                </div>
            {% endif %}
       </div>
        {% if section.settings.image != blank %}
            {{
                section.settings.image
                | image_url: width: 1946
                | image_tag:
                loading: loading,
                sizes: '100vw',
                widths: '246, 493, 600, 713, 823, 990, 1100, 1206, 1346, 1426, 1646, 1946',
                alt: section.settings.image.alt,
                class: "img-starman"
            }}
        {% endif %}
        {% if section.settings.mobile_image != blank %}
            {{
                section.settings.mobile_image
                | image_url: width: 1946
                | image_tag:
                loading: loading,
                sizes: '100vw',
                widths: '246, 493, 600, 713, 823, 990, 1100, 1206, 1346, 1426, 1646, 1946',
                alt: section.settings.mobile_image.alt,
                class: "mobile-img-starman"
            }}
        {% endif %}
    </div>

</section>


<script>
    document.addEventListener("DOMContentLoaded", function(event){


        ScrollTrigger.matchMedia({

            "(min-width: 768px)": function() {

               
                    gsap.fromTo('.aboutus-planet-img',
                        {
                            x: 350,
                            scale:.8,
                            opacity:1,
                            rotation: 360,
                        },
                        {
                            x: 0,
                            rotation: 0,
                            scale:1,
                            opacity:1,
                            duration: 1,
                            ease: "power1.inOut",
                            scrollTrigger: {
                                trigger: ".section-{{ section.id }}",
                                start: "top 50%",
                                end: "top 50%",
                                scrub: 5
                            }
                        }
                    );
                    gsap.fromTo('.imageblock-img',
                        {
                            x: 1000,
                            scale:.5,
                            rotation: 360,
                        },
                        {
                            x: 0,
                            rotation: 0,
                            scale:1,
                            duration: 1,
                            ease: "power2.inOut",
                            scrollTrigger: {
                                trigger: ".section-{{ section.id }}",
                                start: "top 90%",
                                end: "top 10%",
                                scrub: 1
                            }
                        }
                    );


                    gsap.fromTo('.img-violetbubble',
                        {
                            y: -400,
                            scale: 0.3,
                            opacity: .3
                        },
                        {
                            y: 200,
                            scale: 1,
                            opacity: 1,
                            duration: 1,
                            ease: "power3.inOut",
                            scrollTrigger: {
                            trigger: ".section-{{ section.id }}",
                            start: "top center",
                            end: "top top",
                            scrub: true
                            }
                        }
                    );
                    gsap.fromTo('.img-starscrumbs',
                        {
                            y: -500,
                            scale: 1
                            
                        },
                        {
                            y: 100,
                            scale: 1,
                            duration: 1,
                            ease: "power2.inOut",
                            scrollTrigger: {
                                trigger: ".section-{{ section.id }}",
                                start: "top center",
                                end: "top top",
                                scrub: 1
                            }
                        }
                    );
                    gsap.fromTo('.img-starman',
                        {
                            y: 200,
                            scale: 0.9
                        },
                        {
                            y: 0,
                            scale: 1,
                            duration: 1,
                            ease: "power3.inOut",
                            scrollTrigger: {
                            trigger: ".section-{{ section.id }}",
                            start: "top center",
                            end: "bottom top",
                            scrub: true
                            }
                        }
                    );

                   
      
            
            },
            "(max-width: 767px)": function() {
      

                    gsap.fromTo('.aboutus-planet-img, .imageblock-img',
                        {
                            x: 250,
                            opacity:1,
                            scale:.8,
                            rotation: 360,
                        },
                        
                        {
                            x: 0,
                            rotation: 0,
                            scale:1,
                            opacity:1,
                            duration: 1,
                            ease: "power2.inOut",
                            scrollTrigger: {
                                trigger: ".section-{{ section.id }}",
                                start: "top 80%",
                                end: "top 10%",
                                scrub: 1
                            }
                        }
                    );

                    gsap.fromTo('.imageblock-img',
                        {
                            x: 500,
                            scale:.5,
                            rotation: 360,
                        },
                        {
                            x: 0,
                            rotation: 0,
                            scale:1,
                            duration: 1,
                            ease: "power2.inOut",
                            scrollTrigger: {
                                trigger: ".section-{{ section.id }}",
                                start: "top 90%",
                                end: "top 10%",
                                scrub: 1
                            }
                        }
                    );

                    gsap.fromTo('.mobile-img-violetbubble',
                        {
                            y: 0,
                            scale: 0.3,
                            opacity: .3
                        },
                        {
                            y: 400,
                            scale: 1,
                            opacity: 1,
                            duration: 1,
                            ease: "power3.inOut",
                            scrollTrigger: {
                                trigger: ".section-{{ section.id }}",
                                start: "top 90%",
                                end: "bottom 50%",
                                scrub: true
                            }
                        }
                    );
                    gsap.fromTo('.img-starscrumbs',
                        {
                            y: 0,
                            scale: 1
                            
                        },
                        {
                            y: 100,
                            scale: 1,
                            duration: 1,
                            ease: "power2.inOut",
                            scrollTrigger: {
                                trigger: ".section-{{ section.id }}",
                                start: "top center",
                                end: "top top",
                                scrub: 1
                            }
                        }
                    );
                    gsap.fromTo('.mobile-img-starman',
                        {
                            y: 100,
                            scale: 0.9
                        },
                        {
                            y: 0,
                            scale: 1,
                            duration: 1,
                            ease: "power3.inOut",
                            scrollTrigger: {
                            trigger: ".section-{{ section.id }}",
                            start: "top center",
                            end: "bottom top",
                            scrub: true
                            }
                        }
                    );
            }
        })
      
    })
</script>
    

