{% stylesheet %}
  .ssland-sticky-bar-inner {
    max-width: 1280px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .ssland-sticky-bar-info {
    min-width: 0;
    flex: 1;
  }
  .ssland-sticky-bar-label {
    font-family: var(--ssl-font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ssl-ink-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .ssland-sticky-bar-price-row {
    display: flex;
    align-items: baseline;
    gap: 8px;
    white-space: nowrap;
  }
  .ssland-sticky-bar-price {
    font-family: var(--ssl-font-display);
    font-size: 19px;
    font-weight: 400;
    color: var(--ssl-solar-text);
  }
  .ssland-sticky-bar-percan {
    font-family: var(--ssl-font-mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--ssl-signal);
  }
  .ssland-sticky-bar-cta {
    padding: 14px 20px;
    font-size: 13px;
  }
{% endstylesheet %}

{%- liquid
  assign ssl_has_color_override = false
  if section.settings.color_background != blank or section.settings.color_heading != blank or section.settings.color_text != blank or section.settings.color_text_muted != blank or section.settings.color_button_text != blank
    assign ssl_has_color_override = true
  endif
-%}
{%- if ssl_has_color_override -%}
  <style>
    .section-{{ section.id }} {
      {%- if section.settings.color_background != blank %}
      background-color: {{ section.settings.color_background }};
      {%- endif %}
      {%- if section.settings.color_text != blank %}
      color: {{ section.settings.color_text }};
      --ssl-ink: {{ section.settings.color_text }};
      {%- endif %}
      {%- if section.settings.color_text_muted != blank %}
      --ssl-ink-muted: {{ section.settings.color_text_muted }};
      {%- endif %}
    }
    {%- if section.settings.color_heading != blank %}
    .section-{{ section.id }} [class*="-headline"],
    .section-{{ section.id }} [class*="-heading"] {
      color: {{ section.settings.color_heading }};
    }
    {%- endif %}
    {%- if section.settings.color_button_text != blank %}
    .section-{{ section.id }} [class*="-btn-gold"],
    .section-{{ section.id }} [class*="-cta"] {
      color: {{ section.settings.color_button_text }};
    }
    {%- endif %}
  </style>
{%- endif -%}
<div class="ssland-sticky-bar section-{{ section.id }}">
  <div class="ssland-sticky-bar-inner">
    <div class="ssland-sticky-bar-info">
      <div class="ssland-sticky-bar-label">
        <span data-ssland-show="sub">{{ section.settings.sub_label }}</span>
        <span data-ssland-show="once">{{ section.settings.once_label }}</span>
      </div>
      <div class="ssland-sticky-bar-price-row">
        <span class="ssland-sticky-bar-price">
          <span data-ssland-show="sub">{{ section.settings.sub_price }}</span>
          <span data-ssland-show="once">{{ section.settings.once_price }}</span>
        </span>
        <span class="ssland-sticky-bar-percan">
          <span data-ssland-show="sub">{{ section.settings.sub_price_per_can }}</span>
          <span data-ssland-show="once">{{ section.settings.once_price_per_can }}</span>
        </span>
      </div>
    </div>
    <a href="{{ section.settings.cta_url | default: '#offer' }}" class="ssland-btn-gold ssland-sticky-bar-cta">
      {{- section.settings.cta_label -}}
    </a>
  </div>
</div>

{% schema %}
  {
    "name": "SS Landing: Sticky bar",
    "class": "section-ssland-sticky-bar",
    "settings": [
      {
        "type": "paragraph",
        "content": "Fixed purchase bar, shown on screens under 900px only. Values should match the Offer section."
      },
      {
        "type": "text",
        "id": "sub_label",
        "label": "Subscribe label",
        "default": "Star Sweat · 30-pack subscription"
      },
      {
        "type": "text",
        "id": "sub_price",
        "label": "Subscribe price",
        "default": "$95.76"
      },
      {
        "type": "text",
        "id": "sub_price_per_can",
        "label": "Subscribe price per can",
        "default": "$3.19 / can"
      },
      {
        "type": "text",
        "id": "once_label",
        "label": "Buy once label",
        "default": "Star Sweat · one-time 30-pack"
      },
      {
        "type": "text",
        "id": "once_price",
        "label": "Buy once price",
        "default": "$119.70"
      },
      {
        "type": "text",
        "id": "once_price_per_can",
        "label": "Buy once price per can",
        "default": "$3.99 / can"
      },
      {
        "type": "text",
        "id": "cta_label",
        "label": "CTA label",
        "default": "Get Star Sweat"
      },
      {
        "type": "url",
        "id": "cta_url",
        "label": "CTA link"
      },
      { "type": "header", "content": "Colors" },
      { "type": "paragraph", "content": "Leave blank to use the theme's default Star Sweat colors." },
      { "type": "color", "id": "color_background", "label": "Background color" },
      { "type": "color", "id": "color_heading", "label": "Heading color" },
      { "type": "color", "id": "color_text", "label": "Text color" },
      { "type": "color", "id": "color_text_muted", "label": "Muted / secondary text color" },
      { "type": "color", "id": "color_button_text", "label": "Button text color" }
    ],
    "presets": [
      {
        "name": "SS Landing: Sticky bar"
      }
    ],
    "enabled_on": {
      "templates": ["page"]
    }
  }
{% endschema %}
