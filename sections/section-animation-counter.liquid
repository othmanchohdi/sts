{% style %}
  .counter-animation-wrp {
    position: relative;
    overflow: hidden;
    padding-top: 70px;
  }
  .counter-animation-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 30px;
  }
  .counter-animation-img {
    position: relative;
    display: flex;
    align-items: flex-start;
    justify-content: center;
  }
  .counter-animation-img:after {
    content: '';
    padding-bottom: calc(100%/(1));
  }
  .counter-animation-img img {
    position: absolute;
    width: auto;
  }
  .counter-animation-img .counter-animation-1 {
    z-index: 3;
    max-width:400px;
    animation: brightness-2 5s ease-in-out infinite;
  }
  .counter-animation-img .counter-animation-2 {
    z-index: 2;
    animation: brightness-2 5s ease-in-out infinite;
  }
  .counter-animation-img .counter-animation-3 {
    z-index: 1;
    animation: brightness-2 5s ease-in-out infinite;
  }

  .counter-bg-bubble {
    position: absolute;
    width: 100%;
    height: 100%;
    top: 10%;
    border-radius: 100px;
  }
  .counter-bg-bubble-1 {
    max-width: 524px;
    max-height: 276px;
    border-radius: 524px;
    background: rgba(90, 105, 233, 0.50);
    filter: blur(150px);

  }
  .counter-bg-bubble-2 {
    left: 60%;
    max-width: 120px;
    max-height: 120px;
    background: radial-gradient(50% 50% at 50% 50%, #D239FF 0%, rgb(210 57 255 / 59%) 100%);
    filter: blur(49px);
    z-index: 5;
  }
  .counter-bg-bubble-3 {
    left: 20%;
    top: 0;
    max-width: 120px;
    max-height: 120px;
    background: radial-gradient(50% 50% at 50% 50%, #396BFF 0%, rgb(57 107 255 / 43%) 100%);
    filter: blur(31.190284729003906px);
  }
  .counter-animation-column-text {
    position: relative;
  }
  .counter-animation-title {
    line-height: 1.2;
    margin-bottom: 16px;
    padding-right: 8%;
  }
  .counter-animation-title-subtitle {
    background: var(--gradient-1, linear-gradient(180deg, #5B89FF 0%, #D586FF 100%));
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .counter-animation-text p {
    color: var(--grey-20);
    line-height: 25px;
    margin: 0;
  }
  .counter-animation-text p strong {
    color: #fff;
  }

  .round-counters {
    display: flex;
    align-items: center;
    gap: 30px;
    margin-top: 35px;
  }
  .round-counters-canvas {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 300px;
    height: 300px;
  }
  .round-counters-canvas-label {
    position: absolute;
    font-size: 36px;
    line-height: 1;
    max-width: 100px;
    text-align: center;
  }

  .round-counters-data-line {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 35px;
  }
  .round-counters-data-line:last-child {
    margin-bottom: 0;
  }
  .round-counters-bubble-color {
    width: 15px;
    height: 15px;
    border-radius: 50px;
  }

  .round-counters-number {
    min-width: 85px;
    line-height: 1;
  }
  .chart-svg {
    width: 100%;
    height: 100%;
    transform: rotate(-90deg);
  }
  .circle-bg {
    stroke: #222;
    stroke-width: 5;
    fill: none;
  }

  .svg-circle {
    fill: none;
    stroke-width: 5;
    stroke-linecap: round;
    stroke-dasharray: 502;
    stroke-dashoffset: 502;
  }

  /* stars animation */
  .section-{{ section.id }} .star-1
  , .section-{{ section.id }}
  .star-2
  , .section-{{ section.id }}
  .star-3 {
    position: absolute;
    left: 0;
    top: 30%;
    width: 70px;
    height: 70px;
    animation: brightness 3s linear infinite;
  }
  .section-{{ section.id }}
  .star-2 {
    position: absolute;
    left: auto;
    right: 3%;
    top: 45%;
    width: 140px;
    height: 140px;
    animation: brightness 5s linear infinite;
  }
  .section-{{ section.id }}
  .star-3 {
    position: absolute;
    left: auto;
    right: 0;
    top: 2%;
    width: 50px;
    height: 50px;
    animation: brightness 3s linear infinite;
  }

  @media(max-width: 768px) {
    .counter-animation-wrp {
      padding-top: 60px;
    }
    .counter-animation-img:after {
      padding-bottom: calc(100%/(1.2));
    }
    .counter-animation-title {
      padding-right: 24%;
    }
    .counter-animation-grid {
      grid-template-columns: 1fr;
      gap: 30px;
    }
    .round-counters {
      gap: 20px;
      margin-top: 15px;
      justify-content: center;
    }
    .round-counters-canvas {
      width: 160px;
      height: 160px;
    }
    .round-counters-data-line {
      gap: 0;
      flex-wrap: wrap;
    }
    .round-counters-canvas-label {
      font-size: 26px;
    }
    .round-counters-bubble-color {
      width: 10px;
      height: 10px;
    }
    .round-counters-bubble-color {
      margin-right: 9px;
    }
    .round-counters-number {
      width: 50px;
      font-size: 20px;
      min-width: 33px;
    }
    .round-counters-line-label {
      width: 100%;
    }
    .round-counters-data-line {
      margin-bottom: 10px;
    }
    .counter-animation-img .counter-animation-1 {
      max-width:300px;
    }
  }
{% endstyle %}

<section class="counter-animation-wrp section-{{ section.id }}">


  <div class="container">

    <div class="counter-animation-grid">

      <div class="counter-animation-img">

        <div class="star-css star-1"></div>
        <div class="star-css star-css-2 star-2"></div>


        <div class="counter-bg-bubble counter-bg-bubble-1"></div>
        <div class="counter-bg-bubble counter-bg-bubble-2"></div>
        <div class="counter-bg-bubble counter-bg-bubble-3"></div>
        {% if section.settings.image_1 != blank %}
          {{
            section.settings.image_1 | image_url: width: 1000 | image_tag: loading: loading, sizes: '(max-width: 900px) 1000px', widths: '246, 493, 600, 713, 823, 990', alt: section.settings.image_1.alt, class: "counter-animation-1"
          }}
        {% endif %}
        {% if section.settings.image_2 != blank %}
          {{
            section.settings.image_2 | image_url: width: 1946 | image_tag: loading: loading, sizes: '(max-width: 900px) 1000px, (max-width: 2000px) 1900px, 1900px', widths: '246, 493, 600, 713, 823, 990, 1100, 1206, 1346, 1426, 1646, 1946', alt: section.settings.image_2.alt, class: "counter-animation-2"
          }}
        {% endif %}
        {% if section.settings.image_3 != blank %}
          {{
            section.settings.image_3 | image_url: width: 1946 | image_tag: loading: loading, sizes: '(max-width: 900px) 1000px, (max-width: 2000px) 100vw, 50vw', widths: '246, 493, 600, 713, 823, 990, 1100, 1206, 1346, 1426, 1646, 1946', alt: section.settings.image_3.alt, class: "counter-animation-3"
          }}
        {% endif %}
      </div>
      <div class="counter-animation-column-text">

        <div class="star-css star-3"></div>

        {% if section.settings.title != blank %}

          <div class="h2 counter-animation-title overflow-hidden">
            {{ section.settings.title }}
            {% if section.settings.sub_title != blank %}
              <span class="counter-animation-title-subtitle">{{ section.settings.sub_title }}</span>
            {% endif %}
          </div>

        {% endif %}

        {% if section.settings.text != blank %}
          <div class="counter-animation-text">
            {{ section.settings.text }}
          </div>
        {% endif %}

        <div class="round-counters">
          <div class="round-counters-canvas">
            {% if section.settings.counter_label != blank %}
              <div class="round-counters-canvas-label h3">{{ section.settings.counter_label }}</div>
            {% endif %}
            <svg viewBox="0 0 200 200" class="chart-svg">
              <circle
                class="circle-bg"
                cx="100"
                cy="100"
                r="90" />
              <circle
                class="circle-bg"
                cx="100"
                cy="100"
                r="70" />
              <circle
                class="circle-bg"
                cx="100"
                cy="100"
                r="50" />
              <circle
                class="svg-circle circle-blueberries js-blueberries"
                cx="100"
                stroke="{{section.settings.color_3}}"
                data-number="{{section.settings.number_3}}"
                cy="100"
                r="90" />
              <circle
                class="svg-circle circle-bananas js-bananas"
                cx="100"
                stroke="{{section.settings.color_2}}"
                data-number="{{section.settings.number_2}}"
                cy="100"
                r="70" />
              <circle
                class="svg-circle circle-apples js-apples"
                cx="100"
                stroke="{{section.settings.color_1}}"
                data-number="{{section.settings.number_1}}"
                cy="100"
                r="50" />
            </svg>

          </div>
          <div class="round-counters-data">
            {% if section.settings.name_1 != blank or section.settings.number_1 != blank %}
              <div class="round-counters-data-line">
                {% if section.settings.color_1 != blank %}
                  <div class="round-counters-bubble-color" style="background-color:{{section.settings.color_1}};"></div>
                {% endif %}
                <div class="round-counters-number js-round-counters-number h2" data-numbers="{{section.settings.number_1}}">
                  0
                </div>
                <div class="round-counters-line-label h4 weight_500">
                  {{ section.settings.name_1 }}
                </div>
              </div>
            {% endif %}
            {% if section.settings.name_2 != blank or section.settings.number_2 != blank %}
              <div class="round-counters-data-line">
                {% if section.settings.color_2 != blank %}
                  <div class="round-counters-bubble-color" style="background-color:{{section.settings.color_2}};"></div>
                {% endif %}
                <div class="round-counters-number js-round-counters-number h2" data-numbers="{{section.settings.number_2}}">
                  0
                </div>
                <div class="round-counters-line-label h4 weight_500">
                  {{ section.settings.name_2 }}
                </div>
              </div>
            {% endif %}
            {% if section.settings.name_3 != blank or section.settings.number_3 != blank %}
              <div class="round-counters-data-line">
                {% if section.settings.color_3 != blank %}
                  <div class="round-counters-bubble-color" style="background-color:{{section.settings.color_3}};"></div>
                {% endif %}
                <div class="round-counters-number js-round-counters-number h2" data-numbers="{{section.settings.number_3}}">
                  0
                </div>
                <div class="round-counters-line-label h4 weight_500">
                  {{ section.settings.name_3 }}
                </div>
              </div>
            {% endif %}
          </div>
        </div>

      </div>


    </div>

  </div>
</section>


<script>
    document.addEventListener("DOMContentLoaded", function(event){

        
         ScrollTrigger.matchMedia({
            "(min-width: 768px)": function() {
                gsap.fromTo('.counter-animation-1',
                    {
                        x:-300,
                        y:100,
                        scale: .75,
                        rotation: -30
                    },
                    {
                        x: 0,
                        y:0,
                        scale: 1,
                        rotation: -10,
                        duration: 1,
                        ease: "power2.inOut",
                       
                        scrollTrigger: {
                            trigger: ".section-{{ section.id }}",
                            start: "top 90%",
                            end: "bottom 50%",
                            scrub: 1,
                        },
                        
                    }
                );
                gsap.fromTo('.counter-animation-2',
                    {
                        x:-250,
                        y:50,
                        scale: .3,
                        rotation: -50
                    },
                    {
                        x: -130,
                        y:50,
                        scale: 1,
                        rotation: 0,
                        duration: 1,
                        ease: "power2.inOut",
                        scrollTrigger: {
                            trigger: ".section-{{ section.id }}",
                            start: "top 90%",
                            end: "bottom 50%",
                            scrub: 1
                        }
                    }
                );
                gsap.fromTo('.counter-animation-3',
                    {
                        x:350,
                        y:750,
                        scale: .1,
                        rotation: -360
                    },
                    {
                        x: 100,
                        y:360,
                        scale: 1,
                        rotation: 0,
                        duration: 1,
                        ease: "power2.inOut",
                        scrollTrigger: {
                            trigger: ".section-{{ section.id }}",
                            start: "top 90%",
                            end: "bottom 50%",
                            scrub: 1
                        }
                    }
                );
                gsap.fromTo('.counter-bg-bubble-1',
                    {
                    
                        y:0,
                        x:0,
                        scale: .3,
                        rotation: -360
                    },
                    {
                        y:50,
                        x:10,
                        scale: 1,
                        rotation: 0,
                        duration: 1,
                        ease: "power2.inOut",
                        scrollTrigger: {
                            trigger: ".section-{{ section.id }}",
                            start: "top 90%",
                            end: "bottom 50%",
                            scrub: 1
                        }
                    }
                );
                gsap.fromTo('.counter-bg-bubble-2',
                    {
                        x: 0,
                        y:0,
                        scale: .3,
                        rotation: 0
                    },
                    {
                        x: 10,
                        y:100,
                        scale: 1,
                        rotation: 0,
                        duration: 1,
                        ease: "power2.inOut",
                        scrollTrigger: {
                            trigger: ".section-{{ section.id }}",
                            start: "top 90%",
                            end: "bottom 50%",
                            scrub: 1
                        }
                    }
                );
                gsap.fromTo('.counter-bg-bubble-3',
                    {
                        x: 0,
                        y:0,
                        scale: .5,
                        rotation: 0
                    },
                    {
                        x: -20,
                        y:50,
                        scale: 1,
                        rotation: 0,
                        duration: 1,
                        ease: "power2.inOut",
                        scrollTrigger: {
                            trigger: ".section-{{ section.id }}",
                            start: "top 90%",
                            end: "bottom 50%",
                            scrub: 1
                        }
                    }
                );
                
            },
            "(max-width: 768px)": function() {
               gsap.fromTo('.counter-animation-1',
                    {
                        x:-200,
                        y:250,
                        scale: .70,
                        rotation: -70
                    },
                    {
                        x: 0,
                        y:0,
                        scale: 1,
                        rotation: -10,
                        duration: 1,
                        ease: "power2.inOut",
                        scrollTrigger: {
                            trigger: ".section-{{ section.id }}",
                             start: "top 100%",
                            end: "bottom 95%",
                            scrub: 1
                        }
                    }
                );
                gsap.fromTo('.counter-animation-2',
                    {
                        x:-250,
                        y:50,
                        scale: .3,
                        rotation: -50
                    },
                    {
                        x: -70,
                        y:0,
                        scale: 1,
                        rotation: 0,
                        duration: 1,
                        ease: "power2.inOut",
                        scrollTrigger: {
                            trigger: ".section-{{ section.id }}",
                            start: "top 100%",
                             end: "bottom 95%",
                            scrub: 1
                        }
                    }
                );
                gsap.fromTo('.counter-animation-3',
                    {
                        x:150,
                        y:350,
                        scale: .1,
                        rotation: -360
                    },
                    {
                        x: 36,
                        y:205,
                        scale: 1,
                        rotation: 0,
                        duration: 1,
                        ease: "power2.inOut",
                        scrollTrigger: {
                            trigger: ".section-{{ section.id }}",
                          start: "top 100%",
                           end: "bottom 95%",
                            scrub: 1
                        }
                    } 
                );
                gsap.fromTo('.counter-bg-bubble-1',
                    {
                    
                        y:0,
                        scale: .3,
                        rotation: 0
                    },
                    {
                        y:40,
                        scale: .7,
                        rotation: 0,
                        duration: 1,
                        ease: "power2.inOut",
                        scrollTrigger: {
                            trigger: ".section-{{ section.id }}",
                          start: "top 100%",
                           end: "bottom 95%",
                            scrub: 1
                        }
                    }
                );
                gsap.fromTo('.counter-bg-bubble-2',
                    {
                        x: 0,
                        y:0,
                        scale: .3,
                        rotation: 0
                    },
                    {
                        x: 0,
                        y:30,
                        scale: .8,
                        rotation: 0,
                        duration: 1,
                        ease: "power2.inOut",
                        scrollTrigger: {
                            trigger: ".section-{{ section.id }}",
                           start: "top 100%",
                           end: "bottom 95%",
                            scrub: 1
                        }
                    }
                );
                gsap.fromTo('.counter-bg-bubble-3',
                    {
                        x: 0,
                        y:30,
                        scale: .3,
                        rotation: 0
                    },
                    {
                        x: 0,
                        y:30,
                        scale: .9,
                        rotation: 0,
                        duration: 1,
                        ease: "power2.inOut",
                        scrollTrigger: {
                            trigger: ".section-{{ section.id }}",
                           start: "top 100%",
                            end: "bottom 95%",
                            scrub: 1
                        }
                    }
                );
            }

        })

        const getCounterElements = document.querySelectorAll(".js-round-counters-number")
   
        if(getCounterElements.length){
            document.querySelectorAll(".js-round-counters-number").forEach((el) => {
                const final = +el.dataset.numbers;
                gsap.fromTo(el, 
                {
                    innerText: 0
                }, 
                {
                    innerText: final,
                    duration: 3,
                    ease: "power3.out",
                    snap: { 
                        innerText: 1
                    },
                    scrollTrigger: {
                        trigger: ".section-{{ section.id }}",
                        start: "top 50%",
                        end: "bottom 30%",
                        scrub: false,
                            onUpdate: function () {
                            el.innerText = Math.round(el.innerText);
                        }
                    }
                
                });
            });
        }
        const canvasRings = document.querySelectorAll('.svg-circle')
            if(!canvasRings.length) return

        canvasRings.forEach(item => {

            const r = Number(item.getAttribute("r")) || null;
            const value = Number(item.getAttribute("data-number")) || null;

            if(!r && !value) return 
            
            const circumference = 2 * Math.PI * r;
                    
            item.style.strokeDasharray = circumference;


            const percent = (value / 250) * r/100;
            const offset = circumference * (1 - percent);

            gsap.fromTo(
                item, 
                {
                    strokeDashoffset: circumference
                },
                {
                    strokeDashoffset: offset,
                    duration: 2,
                    ease: "power2.out",
                    scrollTrigger: {
                        trigger: ".section-{{ section.id }}",
                        start: "top 60%",
                        end: "top 30%",
                        scrub: false
                    }
                }
            );
        });

       

    })
</script>

