{% stylesheet %}
  .ssland-founder {
    position: relative;
    overflow: clip;
    border-top: 1px solid var(--ssl-hairline);
  }
  .ssland-founder-inner {
    position: relative;
  }
  .ssland-founder-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: clamp(26px, 4vw, 56px);
    align-items: center;
  }
  .ssland-founder-heading {
    font-family: var(--ssl-font-display);
    font-size: clamp(28px, 3.6vw, 48px);
    line-height: 1.05;
    font-weight: 300;
    letter-spacing: normal;
    margin: 0 0 20px;
    text-wrap: balance;
  }
  .ssland-founder-body p {
    margin: 0 0 16px;
    font-size: 16px;
    line-height: 1.6;
    font-weight: 400;
    color: var(--ssl-ink-muted);
  }
  .ssland-founder-signature {
    font-family: var(--ssl-font-mono);
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0.04em;
    color: var(--ssl-ink-muted);
  }
  .ssland-founder-media {
    min-width: 0;
    aspect-ratio: 1 / 1;
    border-radius: 0;
    overflow: hidden;
    border: 1px solid var(--ssl-hairline);
  }
  .ssland-founder-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
{% endstylesheet %}

{%- liquid
  assign ssl_has_color_override = false
  if section.settings.color_background != blank or section.settings.color_heading != blank or section.settings.color_text != blank or section.settings.color_text_muted != blank
    assign ssl_has_color_override = true
  endif
-%}
{%- if ssl_has_color_override -%}
  <style>
    .section-{{ section.id }} {
      {%- if section.settings.color_background != blank %}
      background-color: {{ section.settings.color_background }};
      {%- endif %}
      {%- if section.settings.color_text != blank %}
      color: {{ section.settings.color_text }};
      --ssl-ink: {{ section.settings.color_text }};
      {%- endif %}
      {%- if section.settings.color_text_muted != blank %}
      --ssl-ink-muted: {{ section.settings.color_text_muted }};
      {%- endif %}
    }
    {%- if section.settings.color_heading != blank %}
    .section-{{ section.id }} [class*="-headline"],
    .section-{{ section.id }} [class*="-heading"] {
      color: {{ section.settings.color_heading }};
    }
    {%- endif %}
  </style>
{%- endif -%}
<section class="ssland-founder section-{{ section.id }}">
  <div class="ssland-section-inner ssland-founder-inner">
    <div class="ssland-founder-grid">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <div class="ssland-eyebrow">{{ section.settings.eyebrow }}</div>
        {%- endif -%}
        <h2 class="ssland-founder-heading ssland-font-display">{{ section.settings.heading }}</h2>
        <div class="ssland-founder-body">{{ section.settings.body }}</div>
        {%- if section.settings.signature != blank -%}
          <div class="ssland-founder-signature">{{ section.settings.signature }}</div>
        {%- endif -%}
      </div>
      <div class="ssland-founder-media">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1200
            | image_tag: loading: 'lazy', widths: '400, 600, 900, 1200', alt: section.settings.image.alt
          }}
        {%- else -%}
          {{ 'lifestyle-3' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
  {
    "name": "SS Landing: Founder story",
    "class": "section-ssland-founder",
    "settings": [
      {
        "type": "text",
        "id": "eyebrow",
        "label": "Eyebrow",
        "default": "From Earth to Mars"
      },
      {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "We're made of the same elements as everything out there."
      },
      {
        "type": "richtext",
        "id": "body",
        "label": "Body",
        "default": "<p>Star Sweat exists because the one thing every human takes in every single day — water — is the one thing nobody had bothered to engineer. Wherever people go next, they carry that problem with them.</p><p>I had a version of this on the market before. The copacker couldn't hold the hydrogen in the can, and shipping water that had already lost the one thing it was sold for wasn't something I could keep doing. So I stopped.</p><p>This is the restart. Tested before it ships, with the number printed where you can see it. If it tests low, it doesn't go out. That's the whole standard.</p>"
      },
      {
        "type": "text",
        "id": "signature",
        "label": "Signature line",
        "default": "Mark Ragno — Founder, Star Sweat"
      },
      {
        "type": "image_picker",
        "id": "image",
        "label": "Image"
      },
      { "type": "header", "content": "Colors" },
      { "type": "paragraph", "content": "Leave blank to use the theme's default Star Sweat colors." },
      { "type": "color", "id": "color_background", "label": "Background color" },
      { "type": "color", "id": "color_heading", "label": "Heading color" },
      { "type": "color", "id": "color_text", "label": "Text color" },
      { "type": "color", "id": "color_text_muted", "label": "Muted / secondary text color" }
    ],
    "presets": [
      {
        "name": "SS Landing: Founder story"
      }
    ],
    "enabled_on": {
      "templates": ["page"]
    }
  }
{% endschema %}
