{% comment %}
  Feature-list settings (sub_features / once_features) are textareas, one item
  per line. Prefix a line with "+" for a check mark, "-" for an x mark
  (default: check). Clicking either card or the CTA sets the shared
  [data-ssland-plan] state on <html> — see assets/ssland.js / ssland.css.
{% endcomment %}

{% stylesheet %}
  .ssland-offer {
    position: relative;
    border-top: 1px solid var(--ssl-border-soft);
    background: linear-gradient(180deg, var(--ssl-bg-deep), var(--ssl-bg-navy));
  }
  .ssland-offer-head {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 22px;
    align-items: end;
    margin-bottom: 32px;
  }
  .ssland-offer-heading {
    font-size: clamp(28px, 3.6vw, 46px);
    line-height: 1.02;
    font-weight: 800;
    letter-spacing: -0.025em;
    margin: 0;
    text-wrap: balance;
  }
  .ssland-offer-subcopy {
    margin: 0;
    font-size: 15.5px;
    line-height: 1.55;
    font-weight: 300;
    color: var(--ssl-text-secondary);
  }
  .ssland-offer-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 18px;
  }
  .ssland-offer-card-head {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
  }
  .ssland-offer-card-head-left {
    display: flex;
    align-items: center;
    gap: 13px;
  }
  .ssland-offer-card-title {
    font-size: 20px;
    font-weight: 800;
    letter-spacing: -0.01em;
  }
  .ssland-offer-price-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 12px;
  }
  .ssland-offer-price {
    font-size: clamp(32px, 3.4vw, 42px);
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .ssland-offer-percan {
    font-size: 15px;
  }
  .ssland-offer-card[data-ssland-plan-option='sub'] .ssland-offer-percan {
    color: var(--ssl-accent-bright);
  }
  .ssland-offer-card[data-ssland-plan-option='once'] .ssland-offer-percan {
    color: rgba(244, 241, 234, 0.7);
  }
  .ssland-offer-note {
    font-size: 13px;
    color: var(--ssl-text-tertiary);
    margin: 7px 0 20px;
  }
  .ssland-offer-features {
    display: grid;
    gap: 10px;
    font-size: 14.5px;
    font-weight: 300;
  }
  .ssland-offer-card[data-ssland-plan-option='sub'] .ssland-offer-features {
    color: rgba(244, 241, 234, 0.84);
  }
  .ssland-offer-card[data-ssland-plan-option='once'] .ssland-offer-features {
    color: rgba(244, 241, 234, 0.7);
  }
  .ssland-offer-feature {
    display: flex;
    gap: 11px;
    align-items: flex-start;
  }
  .ssland-offer-feature--no {
    opacity: 0.4;
  }
  .ssland-offer-card[data-ssland-plan-option='sub'] .ssland-offer-feature--yes span:first-child {
    color: var(--ssl-accent-bright);
  }
  .ssland-offer-card[data-ssland-plan-option='once'] .ssland-offer-feature--yes span:first-child {
    color: var(--ssl-silver);
  }
  .ssland-offer-feature span:first-child {
    flex-shrink: 0;
  }
  .ssland-offer-once-note {
    margin-top: 22px;
    padding: 18px;
    border-radius: 14px;
    border: 1px dashed rgba(185, 194, 206, 0.28);
    font-size: 13.5px;
    line-height: 1.5;
    font-weight: 300;
    color: rgba(244, 241, 234, 0.58);
  }
  .ssland-offer-footer {
    max-width: 620px;
    margin: 26px auto 0;
    text-align: center;
  }
  .ssland-offer-footer .ssland-btn-gold {
    width: 100%;
  }
  .ssland-offer-disclaimer {
    margin: 14px 0 0;
    font-size: 13px;
    line-height: 1.55;
    font-weight: 300;
    color: var(--ssl-text-tertiary);
  }
{% endstylesheet %}

<section id="offer" class="ssland-offer section-{{ section.id }}">
  <div class="ssland-section-inner">

    <div class="ssland-offer-head">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <div class="ssland-eyebrow">{{ section.settings.eyebrow }}</div>
        {%- endif -%}
        <h2 class="ssland-offer-heading ssland-font-display">{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.subcopy != blank -%}
        <p class="ssland-offer-subcopy">{{ section.settings.subcopy }}</p>
      {%- endif -%}
    </div>

    <div class="ssland-offer-cards">

      <div
        class="ssland-plan-card ssland-offer-card"
        data-ssland-plan-option="sub"
        data-ssland-plan-trigger="sub"
        role="button"
        tabindex="0"
      >
        <div class="ssland-offer-card-head">
          <div class="ssland-offer-card-head-left">
            <div class="ssland-plan-dot"></div>
            <div class="ssland-offer-card-title ssland-font-display">{{ section.settings.sub_title }}</div>
          </div>
          {%- if section.settings.sub_save_badge != blank -%}
            <div class="ssland-badge ssland-badge--accent" style="background: var(--ssl-accent-gradient); color: #fff; border: none;">
              {{- section.settings.sub_save_badge -}}
            </div>
          {%- endif -%}
        </div>
        <div class="ssland-offer-price-row">
          <span class="ssland-offer-price ssland-font-display">{{ section.settings.sub_price }}</span>
          <span class="ssland-offer-percan">{{ section.settings.sub_price_per_can }}</span>
        </div>
        <div class="ssland-offer-note">{{ section.settings.sub_note }}</div>
        <div class="ssland-offer-features">
          {%- assign sub_feature_lines = section.settings.sub_features | split: "\n" -%}
          {%- for line in sub_feature_lines -%}
            {%- assign line = line | strip -%}
            {%- if line != blank -%}
              {%- assign first_char = line | slice: 0 -%}
              {%- if first_char == '-' -%}
                {%- assign is_ok = false -%}
                {%- assign label = line | slice: 1, 999 | strip -%}
              {%- elsif first_char == '+' -%}
                {%- assign is_ok = true -%}
                {%- assign label = line | slice: 1, 999 | strip -%}
              {%- else -%}
                {%- assign is_ok = true -%}
                {%- assign label = line -%}
              {%- endif -%}
              <div class="ssland-offer-feature {% if is_ok %}ssland-offer-feature--yes{% else %}ssland-offer-feature--no{% endif %}">
                <span>{% if is_ok %}&#10003;{% else %}&#10005;{% endif %}</span>
                <span>{{ label }}</span>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
        {%- if section.settings.founding_badge_label != blank -%}
          <div class="ssland-founding-badge" style="margin-top: 22px;">
            <div class="ssland-font-display" style="font-size: 11px; font-weight: 800; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ssl-accent-bright); margin-bottom: 11px;">
              {{ section.settings.founding_badge_label }}
            </div>
            <div style="display: grid; gap: 8px; font-size: 13.5px; line-height: 1.45; font-weight: 300; color: rgba(244,241,234,0.86);">
              {%- assign founding_badge_lines = section.settings.founding_badge_items | split: "\n" -%}
              {%- for line in founding_badge_lines -%}
                {%- assign line = line | strip -%}
                {%- if line != blank -%}
                  <div>{{ line }}</div>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}
      </div>

      <div
        class="ssland-plan-card ssland-offer-card"
        data-ssland-plan-option="once"
        data-ssland-plan-trigger="once"
        role="button"
        tabindex="0"
      >
        <div class="ssland-offer-card-head">
          <div class="ssland-offer-card-head-left">
            <div class="ssland-plan-dot"></div>
            <div class="ssland-offer-card-title ssland-font-display">{{ section.settings.once_title }}</div>
          </div>
        </div>
        <div class="ssland-offer-price-row">
          <span class="ssland-offer-price ssland-font-display">{{ section.settings.once_price }}</span>
          <span class="ssland-offer-percan">{{ section.settings.once_price_per_can }}</span>
        </div>
        <div class="ssland-offer-note">{{ section.settings.once_note }}</div>
        <div class="ssland-offer-features">
          {%- assign once_feature_lines = section.settings.once_features | split: "\n" -%}
          {%- for line in once_feature_lines -%}
            {%- assign line = line | strip -%}
            {%- if line != blank -%}
              {%- assign first_char = line | slice: 0 -%}
              {%- if first_char == '-' -%}
                {%- assign is_ok = false -%}
                {%- assign label = line | slice: 1, 999 | strip -%}
              {%- elsif first_char == '+' -%}
                {%- assign is_ok = true -%}
                {%- assign label = line | slice: 1, 999 | strip -%}
              {%- else -%}
                {%- assign is_ok = true -%}
                {%- assign label = line -%}
              {%- endif -%}
              <div class="ssland-offer-feature {% if is_ok %}ssland-offer-feature--yes{% else %}ssland-offer-feature--no{% endif %}">
                <span>{% if is_ok %}&#10003;{% else %}&#10005;{% endif %}</span>
                <span>{{ label }}</span>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
        {%- if section.settings.once_note_box != blank -%}
          <div class="ssland-offer-once-note">{{ section.settings.once_note_box }}</div>
        {%- endif -%}
      </div>

    </div>

    <div class="ssland-offer-footer">
      <button type="button" class="ssland-btn-gold" data-ssland-plan-trigger="sub">
        <span data-ssland-show="sub">{{ section.settings.cta_label_sub }}</span>
        <span data-ssland-show="once">{{ section.settings.cta_label_once }}</span>
      </button>
      {%- if section.settings.disclaimer != blank -%}
        <p class="ssland-offer-disclaimer">{{ section.settings.disclaimer }}</p>
      {%- endif -%}
    </div>

  </div>
</section>

{% schema %}
  {
