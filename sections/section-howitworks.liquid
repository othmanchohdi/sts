{% style %}
    .howitworks-wrp{
        padding:20px 0 60px 0; 
    }
    .howitworks-title{
        margin-bottom:25px;
        line-height:1.3;
    }
    .howitworks-grid{
        position:relative;
        display:grid;
        grid-template-columns:1fr 1fr 1fr 1fr;
        gap:30px;
        overflow:hidden;
    }
     .howitworks-img{
        position:relative;
        margin-bottom:30px;
    }
    .howitworks-img:after{
        content:'';
        display:block;
        padding-bottom:calc(100% / (1));
    }
     .howitworks-img img{
        border-radius: 30px;
        position:absolute;
        display:block;
        width:100%;
        height:100%;
        object-fit:cover;
    }
    .howitworks-label {
        padding-right: 16px;
        line-height: 1.5;
        margin-bottom:10px;
    }
    .howitworks-label .howitworks-number{
        transition:all ease-in-out .2s;
    }
    .howitworks-text{
        color: var(--grey-20);
        line-height: 25px;
    }
    .howitworks-text p{
        margin:0;
    }
    .howitworks-btn{
        margin-top:30px;
    }
    .howitworks-card-indicator{
        position:relative;
        display:flex;
        align-items:center;
        margin-bottom: 15px;
    }
    .howitworks-indicator-icon{
        display:flex;
        align-items:center;
        justify-content:center;
        position:relative;
        width: 30px;
        height: 30px;
        border:1px solid #fff;
        border-radius:100px;
        background-color:var(--color--bg);
        transition:all ease-in-out .2s;
    }
    .howitworks-indicator-icon:after{
        content:'';
        width: 14px;
        height: 14px;
        border-radius:100px;
        background-color:#fff;
        transition:all ease-in-out .2s;
    }
    .howitworks-indicator-grey{
        position:absolute; 
        height:2px;
        width:115%;
        background-color:rgba(255,255,255,.1);
    }
     .howitworks-indicator-violet{
        position:absolute; 
        width:435%;
        height:2px;
        background-color:var(--violet);
    }
    .howitworks-col.active .howitworks-indicator-icon{
        border-color: var(--violet);
        transition:all ease-in-out .2s;
    }
    .howitworks-col.active .howitworks-indicator-icon:after{
        background: linear-gradient(180deg, #5B89FF 0%, #D586FF 100%);
        transition:all ease-in-out .2s;
    }
    .howitworks-col.active .howitworks-label .howitworks-number{
        background: var(--gradient, linear-gradient(180deg, #5B89FF 0%, #D586FF 100%));
        background-clip: text;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        transition:all ease-in-out .2s;
    }
    @media(max-width:768px){
         .howitworks-wrp{
                padding:50px 0;
            }
        .howitworks-grid{
            grid-template-columns:1fr 1fr;
            gap:30px 15px;
        }
        .howitworks-card-indicator{
            display:none;
        }
        .howitworks-img{
            margin-bottom:10px;
            border-radius:16px;
        }
        .howitworks-img img{
            border-radius:16px;
        }
        .howitworks-col .howitworks-number{
            display: block;
            background: var(--gradient, linear-gradient(180deg, #5B89FF 0%, #D586FF 100%));
            background-clip: text;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            transition:all ease-in-out .2s;
        }
    }
{% endstyle %}

<section class="howitworks-wrp section-{{ section.id }}">
    <div class="container">
        
        {% if section.settings.label != blank %}

            <div class="caps small color-violet weight_700 center howitworks-label overflow-hidden">{{section.settings.label}}</div>
        
        {% endif %}

        {% if section.settings.title != blank %}

            <div class="h2 howitworks-title center overflow-hidden">{{section.settings.title}}</div>
        
        {% endif %}

        

        <di class="howitworks-grid">
            {% for block in section.blocks %}
                <div class="howitworks-col howitworks-col-{{forloop.index}} {% if forloop.index == 1 %} active{% endif %}">
                    {% if block.settings.image != blank %}
                        <div class="howitworks-img">
                            {{
                                block.settings.image
                                | image_url: width: 1946
                                | image_tag:
                                loading: loading,
                                sizes: '100vw',
                                widths: '246, 493, 600, 713, 823, 990, 1100, 1206, 1346, 1426, 1646, 1946',
                                alt: block.settings.image.alt
                            }}
                        </div>
                    {% endif %}
                    <div class="howitworks-card-indicator">
                        <div class="howitworks-indicator-grey"></div>
                        {% if forloop.index == 1 %}
                            <div class="howitworks-indicator-violet"></div>
                        {% endif %}
                        <div class="howitworks-indicator-icon"></div>
                    </div>
                    {% if block.settings.title != blank %}
                        <div class="howitworks-label h5"><span class="howitworks-number">0{{forloop.index}}.</span> {{ block.settings.title }}</div>
                    {% endif %}
                    {% if block.settings.text != blank %}
                        <div class="howitworks-text">{{ block.settings.text }}</div>
                    {% endif %}
                </div>
            {% endfor %}
        </di>

         {% if section.settings.button_label != blank %}
                <div class="howitworks-btn center">
                    <a href="{{section.settings.url | default: '#'}}" 
                    target="_blank"
                    class="overflow-hidden weight-700 h6 c-btn c-btn-icon c-btn--dark">
                        {{ section.settings.button_label }}
                        {% render 'icon' with 'starship-violet' %}
                     
                    </a>
                </div>
            {% endif %}

    </div>

</section>

<script>
       document.addEventListener("DOMContentLoaded", function(event){


            const scrollStepTm = [
                { threshold: -1290, el: document.querySelector('.howitworks-col-1') },
                { threshold: -1015, el: document.querySelector('.howitworks-col-2') },
                { threshold: -670, el: document.querySelector('.howitworks-col-3') },
                { threshold: -325, el: document.querySelector('.howitworks-col-4') }
            ];
            ScrollTrigger.matchMedia({
                "(min-width: 768px)": function() {
                    
                     gsap.fromTo('.howitworks-indicator-violet',
                     
                        {
                            x:-1290
                        },
                        {
                            x: 0,
                            duration: 1,
                            ease: "power2.inOut",
                            scrollTrigger: {
                                trigger: ".section-{{ section.id }}",
                                start: "top 80%",
                                end: "bottom 40%",
                                scrub: 1,
                                 onUpdate: self => {
                                    const currentX = gsap.getProperty('.howitworks-indicator-violet', "x");

                                    scrollStepTm.forEach((step, index) => {
                                    if (currentX >= step.threshold) {
                                        step.el.classList.add("active");
                                    } else {
                                        step.el.classList.remove("active");
                                    }
                                    });
                                }
                            }
                        }
                    );
                }
            })

       })
</script>
    

{% schema %}
{
  "name": "How it works",
  "class": "section-howitworks",
  "settings": [
        {
            "type": "text",
            "id": "label",
            "label": "Label"
        },
         {
            "type": "text",
            "id": "title",
            "label": "Title"
        },
        {
            "type": "text",
            "id": "button_label",
            "label": "Button label"
        },
        {
            "type": "url",
            "id": "url",
            "label": "Url"
        }
  ],
   "blocks": [
        {
          "type": "block",
          "name": "Card",
          "settings": [
             {
                "type": "image_picker",
                "id": "image",
                "label": "Image"
            },
            {
                "type": "text",
                "id": "title",
                "label": "Title"
            },
                {
                "type": "richtext",
                "id": "text",
                "label": "Text"
            }
          ]
        }
      ],
  "presets": [
    {
      "name": "How it works",
    }
  ],
  "enabled_on": {
    "templates": [
      "404",
      "article",
      "blog",
      "cart",
      "collection",
      "index",
      "list-collections",
      "page",
      "product",
      "search"
    ],
    "groups": ["footer"]
  }
}
{% endschema %}
