{% stylesheet %}
  .ssland-testimonials {
    border-top: 1px solid var(--ssl-hairline);
    background: var(--ssl-base);
  }
  .ssland-testimonials-head {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 34px;
  }
  .ssland-testimonials-heading {
    font-family: var(--ssl-font-display);
    font-size: clamp(28px, 3.4vw, 42px);
    line-height: 1.05;
    font-weight: 300;
    letter-spacing: normal;
    margin: 0;
  }
  .ssland-testimonials-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 16px;
  }
  .ssland-testimonial-card {
    min-width: 0;
    border-radius: var(--ssl-radius-card);
    padding: 30px 26px;
    border: 1px solid var(--ssl-hairline);
    background: var(--ssl-surface);
  }
  .ssland-testimonial-label {
    font-family: var(--ssl-font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ssl-ink-muted);
    margin-bottom: 16px;
    font-weight: 400;
  }
  .ssland-testimonial-quote {
    font-family: var(--ssl-font-display);
    margin: 0 0 20px;
    font-size: 19px;
    line-height: 1.4;
    font-weight: 400;
    letter-spacing: normal;
  }
  .ssland-testimonial-byline {
    font-family: var(--ssl-font-mono);
    font-size: 13px;
    letter-spacing: 0.04em;
    font-weight: 400;
    color: var(--ssl-ink-muted);
  }
{% endstylesheet %}

{%- liquid
  assign ssl_has_color_override = false
  if section.settings.color_background != blank or section.settings.color_heading != blank or section.settings.color_text != blank or section.settings.color_text_muted != blank or section.settings.color_button_text != blank
    assign ssl_has_color_override = true
  endif
-%}
{%- if ssl_has_color_override -%}
  <style>
    .section-{{ section.id }} {
      {%- if section.settings.color_background != blank %}
      background-color: {{ section.settings.color_background }};
      {%- endif %}
      {%- if section.settings.color_text != blank %}
      color: {{ section.settings.color_text }};
      --ssl-ink: {{ section.settings.color_text }};
      {%- endif %}
      {%- if section.settings.color_text_muted != blank %}
      --ssl-ink-muted: {{ section.settings.color_text_muted }};
      {%- endif %}
    }
    {%- if section.settings.color_heading != blank %}
    .section-{{ section.id }} [class*="-headline"],
    .section-{{ section.id }} [class*="-heading"] {
      color: {{ section.settings.color_heading }};
    }
    {%- endif %}
    {%- if section.settings.color_button_text != blank %}
    .section-{{ section.id }} [class*="-btn-gold"],
    .section-{{ section.id }} [class*="-cta"] {
      color: {{ section.settings.color_button_text }};
    }
    {%- endif %}
  </style>
{%- endif -%}
<section class="ssland-testimonials section-{{ section.id }}">
  <div class="ssland-section-inner">

    <div class="ssland-testimonials-head">
      <h2 class="ssland-testimonials-heading">{{ section.settings.heading }}</h2>
    </div>

    <div class="ssland-testimonials-grid">
      {%- for block in section.blocks -%}
        <div class="ssland-testimonial-card" {{ block.shopify_attributes }}>
          {%- if block.settings.label != blank -%}
            <div class="ssland-testimonial-label">{{ block.settings.label }}</div>
          {%- endif -%}
          <p class="ssland-testimonial-quote">&ldquo;{{ block.settings.quote }}&rdquo;</p>
          <div class="ssland-testimonial-byline">{{ block.settings.name }} &middot; {{ block.settings.location }}</div>
        </div>
      {%- endfor -%}
    </div>

  </div>
</section>

{% schema %}
  {
    "name": "SS Landing: Testimonials",
    "class": "section-ssland-testimonials",
    "settings": [
      {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "What early drinkers say"
      },
      { "type": "header", "content": "Colors" },
      { "type": "paragraph", "content": "Leave blank to use the theme's default Star Sweat colors." },
      { "type": "color", "id": "color_background", "label": "Background color" },
      { "type": "color", "id": "color_heading", "label": "Heading color" },
      { "type": "color", "id": "color_text", "label": "Text color" },
      { "type": "color", "id": "color_text_muted", "label": "Muted / secondary text color" },
      { "type": "color", "id": "color_button_text", "label": "Button text color" }
    ],
    "blocks": [
      {
        "type": "testimonial",
        "name": "Testimonial",
        "settings": [
          {
            "type": "text",
            "id": "label",
            "label": "Label",
            "default": "Early drinker"
          },
          {
            "type": "textarea",
            "id": "quote",
            "label": "Quote",
            "default": "Cold out of the fridge it tastes like nothing at all, which is exactly what I wanted from water."
          },
          {
            "type": "text",
            "id": "name",
            "label": "Name",
            "default": "Jordan L."
          },
          {
            "type": "text",
            "id": "location",
            "label": "Location",
            "default": "Austin, TX"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "SS Landing: Testimonials",
        "blocks": [
          { "type": "testimonial", "settings": { "label": "Early drinker", "quote": "Cold out of the fridge it tastes like nothing at all, which is exactly what I wanted from water.", "name": "Jordan L.", "location": "Austin, TX" } },
          { "type": "testimonial", "settings": { "label": "Founding member", "quote": "The box on the counter is what made it stick. One can with breakfast and I stopped thinking about it.", "name": "Maya R.", "location": "Los Angeles, CA" } },
          { "type": "testimonial", "settings": { "label": "Subscriber", "quote": "I bought it because the can was the only version of this I could see myself drinking every day.", "name": "Chris T.", "location": "New York, NY" } }
        ]
      }
    ],
    "enabled_on": {
      "templates": ["page"]
    }
  }
{% endschema %}
