{% schema %}
  {
    "name": "Research",
    "class": "section-research",
    "settings": [],
    "blocks": [
      {
        "type": "block_text",
        "name": "Text block",
        "settings": [
          {
            "type": "text",
            "id": "title",
            "label": "Title"
          }, {
            "type": "richtext",
            "id": "text",
            "label": "Text"
          }, {
            "type": "checkbox",
            "id": "bordered",
            "label": "In border",
            "default": false
          }
        ]
      }, {
        "type": "block_img",
        "name": "Text block image",
        "settings": [
          {
            "type": "text",
            "id": "title",
            "label": "Title"
          }, {
            "type": "richtext",
            "id": "text",
            "label": "Text"
          }, {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Research"
      }
    ],
    "enabled_on": {
      "templates": [
        "404",
        "article",
        "blog",
        "cart",
        "collection",
        "index",
        "list-collections",
        "page",
        "product",
        "search"
      ],
      "groups": ["footer"]
    }
  }
{% endschema %}