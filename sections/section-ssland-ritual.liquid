{% stylesheet %}
  .ssland-ritual-head {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 26px;
    align-items: end;
    margin-bottom: 34px;
  }
  .ssland-ritual-heading {
    font-size: clamp(30px, 4vw, 52px);
    line-height: 1;
    font-weight: 800;
    letter-spacing: -0.03em;
    margin: 0;
    text-wrap: balance;
  }
  .ssland-ritual-subcopy {
    margin: 0;
    font-size: 15.5px;
    line-height: 1.55;
    font-weight: 300;
    color: var(--ssl-text-secondary);
  }
  .ssland-ritual-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 14px;
  }
  .ssland-ritual-hero {
    grid-column: 1 / -1;
    position: relative;
    aspect-ratio: 21 / 9;
    border-radius: 20px;
    overflow: hidden;
    border: 1px solid var(--ssl-border);
  }
  .ssland-ritual-hero img,
  .ssland-ritual-tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .ssland-ritual-hero-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(5, 7, 13, 0.5), transparent);
  }
  .ssland-ritual-hero-caption {
    position: absolute;
    bottom: 28px;
    left: 28px;
  }
  .ssland-ritual-hero-label {
    margin-bottom: 6px;
  }
  .ssland-ritual-hero-title {
    font-size: 24px;
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .ssland-ritual-tile {
    min-width: 0;
    aspect-ratio: 4 / 5;
    border-radius: 18px;
    overflow: hidden;
    border: 1px solid var(--ssl-border);
    position: relative;
  }
  .ssland-ritual-tile-caption {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 24px 20px;
    background: linear-gradient(0deg, rgba(5, 7, 13, 0.82), transparent);
  }
  .ssland-ritual-tile-label {
    margin-bottom: 2px;
  }
  .ssland-ritual-tile-text {
    font-size: 13.5px;
    font-weight: 300;
    color: var(--ssl-text-secondary);
  }
{% endstylesheet %}

<section class="section-{{ section.id }}">
  <div class="ssland-section-inner">

    <div class="ssland-ritual-head">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <div class="ssland-eyebrow">{{ section.settings.eyebrow }}</div>
        {%- endif -%}
        <h2 class="ssland-ritual-heading ssland-font-display">{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.subcopy != blank -%}
        <p class="ssland-ritual-subcopy">{{ section.settings.subcopy }}</p>
      {%- endif -%}
    </div>

    <div class="ssland-ritual-grid">
      <div class="ssland-ritual-hero">
        {%- if section.settings.hero_image != blank -%}
          {{
            section.settings.hero_image
            | image_url: width: 1800
            | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1800', alt: section.settings.hero_image.alt
          }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
        <div class="ssland-ritual-hero-scrim"></div>
        <div class="ssland-ritual-hero-caption">
          <div class="ssland-eyebrow ssland-ritual-hero-label">{{ section.settings.hero_label }}</div>
          <div class="ssland-ritual-hero-title ssland-font-display">{{ section.settings.hero_caption }}</div>
        </div>
      </div>

      {%- for block in section.blocks -%}
        <div class="ssland-ritual-tile" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{
              block.settings.image
              | image_url: width: 800
              | image_tag: loading: 'lazy', widths: '300, 500, 800', alt: block.settings.image.alt
            }}
          {%- else -%}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
          <div class="ssland-ritual-tile-caption">
            <div class="ssland-eyebrow ssland-ritual-tile-label">{{ block.settings.label }}</div>
            <div class="ssland-ritual-tile-text">{{ block.settings.caption }}</div>
          </div>
        </div>
      {%- endfor -%}
    </div>

  </div>
</section>

{% schema %}
  {
    "name": "SS Landing: Daily ritual",
    "class": "section-ssland-ritual",
    "settings": [
      {
        "type": "text",
        "id": "eyebrow",
        "label": "Eyebrow",
        "default": "The daily ritual"
      },
      {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "One can. One ritual. Every day."
      },
      {
        "type": "text",
        "id": "subcopy",
        "label": "Subcopy",
        "default": "Not a case in the garage. A month of mornings, already decided."
      },
      {
        "type": "header",
        "content": "Hero image"
      },
      {
        "type": "image_picker",
        "id": "hero_image",
        "label": "Hero image"
      },
      {
        "type": "text",
        "id": "hero_label",
        "label": "Hero label",
        "default": "Morning"
      },
      {
        "type": "text",
        "id": "hero_caption",
        "label": "Hero caption",
        "default": "One can. One ritual."
      }
    ],
    "blocks": [
      {
        "type": "moment",
        "name": "Moment",
        "settings": [
          {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
          },
          {
            "type": "text",
            "id": "label",
            "label": "Label",
            "default": "Training"
          },
          {
            "type": "text",
            "id": "caption",
            "label": "Caption",
            "default": "Post-workout recovery"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "SS Landing: Daily ritual",
        "blocks": [
          { "type": "moment", "settings": { "label": "Training", "caption": "Post-workout recovery" } },
          { "type": "moment", "settings": { "label": "Focus", "caption": "Desk, 9am" } },
          { "type": "moment", "settings": { "label": "Evening", "caption": "Wind-down ritual" } }
        ]
      }
    ],
    "enabled_on": {
      "templates": ["page"]
    }
  }
{% endschema %}
