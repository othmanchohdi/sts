{% stylesheet %}
  .ssland-topbar-marquee {
    overflow: hidden;
    background: var(--ssl-base);
    border-bottom: 1px solid var(--ssl-hairline);
  }
  .ssland-topbar-marquee-track {
    display: flex;
    width: max-content;
  }
  .ssland-topbar-marquee-group {
    display: flex;
    gap: 44px;
    padding: 10px 22px;
    font-family: var(--ssl-font-mono);
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--ssl-ink-muted);
  }
  .ssland-topbar-marquee-item--accent {
    color: var(--ssl-violet);
  }
  .ssland-topbar-marquee-item--silver {
    color: var(--ssl-control-border);
  }
  .ssland-topbar-header {
    position: relative;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    max-width: 1280px;
    margin: 0 auto;
    padding: 22px;
  }
  .ssland-topbar-logo {
    font-size: 18px;
    font-weight: 500;
    letter-spacing: normal;
    text-transform: none;
  }
  .ssland-topbar-right {
    display: flex;
    align-items: center;
    gap: 22px;
  }
  .ssland-topbar-eyebrow {
    font-family: var(--ssl-font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ssl-ink-muted);
    white-space: nowrap;
  }
  .ssland-topbar-cta {
    padding: 10px 18px;
    border-radius: var(--ssl-radius-control);
    background: var(--ssl-solar);
    border: none;
    color: #111214;
    font-family: var(--ssl-font-display);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: normal;
    text-transform: none;
    white-space: nowrap;
    transition: background-color 0.2s ease;
  }
  .ssland-topbar-cta:hover {
    background: #e79433;
  }
{% endstylesheet %}

<div class="section-{{ section.id }}">

  {%- if section.blocks.size > 0 -%}
    <div class="ssland-topbar-marquee">
      <div class="ssland-topbar-marquee-track ssland-animate-marquee">
        {%- for i in (1..2) -%}
          <div class="ssland-topbar-marquee-group">
            {%- for block in section.blocks -%}
              <span
                class="ssland-topbar-marquee-item--{{ block.settings.style }}"
                {{ block.shopify_attributes }}
              >
                {{- block.settings.text -}}
              </span>
            {%- endfor -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  <header class="ssland-topbar-header">
    <div class="ssland-topbar-logo ssland-font-display">{{ section.settings.logo_text }}</div>
    <div class="ssland-topbar-right">
      {%- if section.settings.nav_label != blank -%}
        <span class="ssland-topbar-eyebrow">{{ section.settings.nav_label }}</span>
      {%- endif -%}
      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_url | default: '#offer' }}" class="ssland-topbar-cta ssland-font-display">
          {{- section.settings.cta_label -}}
        </a>
      {%- endif -%}
    </div>
  </header>

</div>

{% schema %}
  {
    "name": "SS Landing: Top bar",
    "class": "section-ssland-topbar",
    "settings": [
      {
        "type": "text",
        "id": "logo_text",
        "label": "Logo text",
        "default": "Star Sweat"
      },
      {
        "type": "text",
        "id": "nav_label",
        "label": "Nav label",
        "default": "Elemental Water"
      },
      {
        "type": "text",
        "id": "cta_label",
        "label": "CTA button label",
        "default": "Get Star Sweat"
      },
      {
        "type": "url",
        "id": "cta_url",
        "label": "CTA button link"
      }
    ],
    "blocks": [
      {
        "type": "marquee_item",
        "name": "Marquee item",
        "settings": [
          {
            "type": "text",
            "id": "text",
            "label": "Text",
            "default": "The water of the future has arrived"
          },
          {
            "type": "select",
            "id": "style",
            "label": "Color",
            "options": [
              { "value": "accent", "label": "Accent (purple)" },
              { "value": "silver", "label": "Silver" },
              { "value": "plain", "label": "Plain" }
            ],
            "default": "accent"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "SS Landing: Top bar",
        "blocks": [
          { "type": "marquee_item", "settings": { "text": "The water of the future has arrived", "style": "accent" } },
          { "type": "marquee_item", "settings": { "text": "Free shipping on subscriptions", "style": "silver" } },
          { "type": "marquee_item", "settings": { "text": "2.2 ppm H₂ verified", "style": "plain" } }
        ]
      }
    ],
    "enabled_on": {
      "templates": ["page"]
    }
  }
{% endschema %}
