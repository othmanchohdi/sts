{% stylesheet %}
  .ssland-benefits {
    position: relative;
    border-top: 1px solid var(--ssl-hairline);
  }
  .ssland-benefits-inner {
    position: relative;
  }
  .ssland-benefits-head {
    max-width: 640px;
    margin-bottom: 40px;
  }
  .ssland-benefits-heading {
    font-family: var(--ssl-font-display);
    font-size: clamp(30px, 4vw, 48px);
    line-height: 1.05;
    font-weight: 300;
    letter-spacing: normal;
    margin: 0 0 16px;
    text-wrap: balance;
  }
  .ssland-benefits-subcopy {
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    font-weight: 400;
    color: var(--ssl-ink-muted);
  }
  .ssland-benefits-subcopy p {
    margin: 0;
  }
  .ssland-benefits-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1px;
    background: var(--ssl-hairline);
    border: 1px solid var(--ssl-hairline);
    border-radius: var(--ssl-radius-card);
    overflow: hidden;
  }
  .ssland-benefit-card {
    padding: 30px 26px;
    background: var(--ssl-surface);
    min-width: 0;
  }
  .ssland-benefit-num {
    font-family: var(--ssl-font-mono);
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0.04em;
    color: var(--ssl-violet);
    margin-bottom: 18px;
  }
  .ssland-benefit-title {
    font-family: var(--ssl-font-display);
    font-size: 20px;
    font-weight: 400;
    letter-spacing: normal;
    margin: 0 0 10px;
  }
  .ssland-benefit-body {
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
    font-weight: 400;
    color: var(--ssl-ink-muted);
  }
  .ssland-benefit-body p {
    margin: 0;
  }
  .ssland-benefits-disclaimer {
    margin: 16px 0 0;
    font-size: 13px;
    line-height: 1.5;
    font-weight: 400;
    color: var(--ssl-ink-muted);
    max-width: 76ch;
  }
{% endstylesheet %}

<section class="ssland-benefits section-{{ section.id }}">
  <div class="ssland-section-inner ssland-benefits-inner">

    <div class="ssland-benefits-head">
      {%- if section.settings.eyebrow != blank -%}
        <div class="ssland-eyebrow">{{ section.settings.eyebrow }}</div>
      {%- endif -%}
      <h2 class="ssland-benefits-heading ssland-font-display">{{ section.settings.heading }}</h2>
      {%- if section.settings.subcopy != blank -%}
        <div class="ssland-benefits-subcopy">{{ section.settings.subcopy }}</div>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="ssland-benefits-grid">
        {%- for block in section.blocks -%}
          <div class="ssland-benefit-card" {{ block.shopify_attributes }}>
            <div class="ssland-benefit-num">{{ block.settings.number }}</div>
            <h3 class="ssland-benefit-title ssland-font-display">{{ block.settings.title }}</h3>
            <div class="ssland-benefit-body">{{ block.settings.body }}</div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.disclaimer != blank -%}
      <p class="ssland-benefits-disclaimer">{{ section.settings.disclaimer }}</p>
    {%- endif -%}

  </div>
</section>

