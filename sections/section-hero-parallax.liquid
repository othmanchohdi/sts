{% style %}
    .herobanner-wrp{
        margin-top:-30px;
        position:relative;
        display:flex;
        align-items:flex-start;
        justify-content:center;
        overflow:hidden;
    }
    .herobanner-bg-img{
        height:100vh;
        width:100%;
        object-fit:cover;
        animation:brightness-2 5s linear infinite;
    }
    .herobanner-image-overlay{
        position:absolute;
        top:0;
        left:0;
        width:100%;
        height:100%;
        background: linear-gradient(to bottom,  rgba(0,0,0,0.54) 0%,rgba(0,0,0,0) 35%,rgba(0,0,0,0) 100%); /* W3C, IE10+, FF16+, Chrome26+, Opera12+, Safari7+ */
    }
    .herobanner-content{
        position:absolute;
        padding-top:150px;
        z-index:3;
    }
    .herobanner-title{
        font-size: 72px;
        line-height: 61px;
        max-width: 450px;
        margin:auto;
        word-wrap: break-word;
        opacity:0; 
    }
    .herobanner-label{
       opacity:0;
    }
    .herobanner-btn{
        margin-top:16px;
    }
    .herobanner-btn .c-btn{
       opacity:0;
    }
    .herobanner-bottom-text-line.mobile-bottom-text-line{
        display:none;
    }
    .herobanner-bottom-text-line{
        position:absolute;
        left:7%;
        bottom:30%;
        max-width: 470px;
        align-items: center;
        text-align: left;
         display: flex;
         gap: 15px;
        z-index:3;
     }
     .herobanner-bottom-text-line svg{
        max-width:70px;
        width:100%;
     } 
    .herobanner-bottom-text{
        line-height: 1.3;
        font-size:21px;
        opacity:0;
    }
    .herobanner-main_image, .herobanner-image_1, .herobanner-image_1, .herobanner-image_2, .herobanner-image_3{
        display:block;
        position:absolute;
    }
    .herobanner-main_image{
        bottom:-130px;
        max-width:50%;
        transform: rotate(20deg);
         animation: waves 15s linear infinite, brightness-2 5s linear infinite;
    }
    .herobanner-image_1{
        bottom: 9%;
        z-index: 1;
        left: 35%;
        animation: rotating 50s linear infinite, brightness 7s linear infinite;
    }
    .herobanner-image_2{
        bottom: 36%;
        right: 31%;
        animation: rotating-2 50s linear infinite, brightness 7s linear infinite;
    }
     .herobanner-image_3{
        bottom: 27%;
        z-index: 1;
        left: 54%;
    }
     .hero-widget-image-mobile{
        display:none;
     }
    .hero-widget-image-desktop{
        position:absolute;
        right:10%;
        bottom:20%;
        animation: brightness 3s linear infinite;
        opacity:0;
    }

    @media(max-width:768px){
        .hero-widget-image-desktop{
            display:none;
        }
        .hero-widget-image-mobile {
            margin: 15px 10px 0 15px;
            display: inline-flex;
            animation: brightness 3s linear infinite;
        }
        .herobanner-content{
            padding-top: 90px;
        }
        .herobanner-bg-img{
            height: 97vh;
        }
        .herobanner-label{
            font-size:24px;
            line-height: 1;
        }
        .herobanner-title{
            font-size:40px;
            line-height: 1;
        }
        .herobanner-btn{
            margin-top: 10px;
        }
        .herobanner-bottom-text-line{
            display:none;
            top: 33%;
            left: 0;
            bottom: auto;
            width: 100%;
            max-width: 100%;
             align-items: center;
        }
        .herobanner-bottom-text{
            font-size: 16px;
            line-height: 19px;
            margin: auto;
            max-width: 400px;
            padding: 0 0;
        }
       .herobanner-bottom-text-line.mobile-bottom-text-line{
            position:static;
            display:flex;
            padding:0 15px;
            gap:5px;
            margin-top:15px;
        }
        .herobanner-image_1{
            max-width:40%;
            bottom: 9%;
            left: 9%;
        }
        .herobanner-image_2{
            max-width:30%;
            bottom: 34%;
            right: 9%;
        }
    }
     @media(max-width:576px){
        .herobanner-bottom-text-line{
            top: 25%;
        }
     }

    @media(max-width:500px){
         .herobanner-main_image{
            bottom: -50px;
         }
     }
    
      @media(max-width:375px){
        .herobanner-content {
            padding-top: 19%;
        }
        .herobanner-bottom-text-line{
            top: 27%;
        }
     }



    
@media(max-height: 1000px) and (min-width: 1000px) {
    .herobanner-main_image {
        max-width: 20%;
    }
    .herobanner-image_2, .herobanner-image_1 {
        max-width: 10%;
    }
}
@media(max-height: 1000px) and (min-width: 1500px) {
    .herobanner-main_image {
        max-width: 17%;
    }
    .herobanner-image_2, .herobanner-image_1 {
        max-width: 10%;
    }
}
@media(max-height: 1000px) and (min-width: 4500px) {
    .herobanner-main_image {
        max-width: 10%;
    }
    .herobanner-image_2, .herobanner-image_1 {
        max-width: 10%;
    }
}
@media(max-height: 1000px) and (max-width: 991px) {
    .herobanner-main_image {
        max-width: 30%;
    } 
    .herobanner-image_2, .herobanner-image_1 {
        max-width: 10%;
    }
}
  @media(max-height: 1000px) and (max-width: 630px) {
        .herobanner-main_image {
            max-width: 40%;
        }
        .herobanner-image_2, .herobanner-image_1 {
            max-width: 20%;
        }
    } 
      @media(max-height: 1000px) and (max-width: 400px) {
        .herobanner-main_image {
            max-width: 50%;
        }
        .herobanner-image_2, .herobanner-image_1 {
            max-width: 30%;
        }
    } 

{% endstyle %}

