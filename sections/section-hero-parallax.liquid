                class: "herobanner-image_3"
            }}
        {% endif %}

           {% if section.settings.main_image != blank %}
            {{
                section.settings.main_image
                | image_url: width: 400
                | image_tag:
                loading: loading,
                sizes: '100vw',
                widths: '246, 493, 600, 713, 823, 990, 1100, 1206, 1346, 1426, 1646, 1946',
                alt: section.settings.main_image.alt,
                class: "herobanner-main_image"
            }}
        {% endif %}
       


</section>

<script>
 document.addEventListener("DOMContentLoaded", function(event){
        //GSAP Animation START
        let heroBannerTextTl = gsap.timeline({
            scrollTrigger:{
                trigger: '.section-{{ section.id }}',
                start: 'top center',
                end: 'bottom center'
            }
        })

        let heroTextSlitGsap = SplitText.create('.js-herobanner-bottom-text, .js-mobile-bottom-text',{
            type: "chars, words"
        })
        heroBannerTextTl.set('.js-herobanner-bottom-text, .js-mobile-bottom-text',{
            opacity: 1
        })

        let heroTitleSlitGsap = SplitText.create('.js-herobanner-title',{
            type: "chars, words",
        })
        heroBannerTextTl.set('.js-herobanner-title',{
            opacity: 1
        })
        let heroLabelSlitGsap = SplitText.create('.js-herobanner-label',{
            type: "chars, words",
        })
        heroBannerTextTl.set('.js-herobanner-label',{
            opacity: 1
        })
        heroBannerTextTl.from(heroLabelSlitGsap.words, {
            y: 100,
            autoAlpha:0,
            delay: 0,
            
        },0.7)
        heroBannerTextTl.from(heroTitleSlitGsap.words, {
            y: 100,
            autoAlpha:0,
            delay: 0,
            stagger: 0.05
        },0.3)
        heroBannerTextTl.fromTo(document.querySelector('.section-{{ section.id }} .js-herobanner-btn'),
            {
                y:100,
                opacity:0
            },
            {
                y:0,
                opacity:1,
                ease: "power2.inOut",
            },
            0.7
        )
        heroBannerTextTl.from(heroTextSlitGsap.chars, {
            y: 100,
            autoAlpha:0,
            delay: 1,
            stagger: {
                amount: 1,
                from: 'random',
                yoyo: true
            }
            
        },0.7)

        heroBannerTextTl.fromTo(document.querySelector('.section-{{ section.id }} .hero-widget-image-desktop'),
            {
                opacity:0
            },
            {
                opacity:1,
                ease: "power2.inOut",
            },
            2
        )
        

})
</script>
    

